# Port Coordination Service - Example Environment Variables

# HTTP listen port (default 58552)
PORTCOORD_PORT=58552

# Data directory for SQLite database (default ./data)
PORTCOORD_DATA_DIR=./data

# Database file name (default portcoord.db)
PORTCOORD_DB_NAME=portcoord.db

# Request timeout in seconds (default 30)
PORTCOORD_REQUEST_TIMEOUT=30

# Scheduler tick interval in seconds (default 5)
PORTCOORD_SCHEDULER_INTERVAL=5

# Lease timeout in seconds (default 60)
PORTCOORD_LEASE_TIMEOUT=60

# Escalation check interval in seconds (default 10)
PORTCOORD_ESCALATION_INTERVAL=10

# Log level: debug, info, warn, error (default info)
PORTCOORD_LOG_LEVEL=info

# Executor poll interval in seconds (default 3)
PORTCOORD_EXECUTOR_INTERVAL=3

# Executor ID (default auto-generated)
PORTCOORD_EXECUTOR_ID=executor-1
